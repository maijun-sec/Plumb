<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                              http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.plumb</groupId>
    <artifactId>plumb</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>plumb</name>
    <description>
        A Java static analysis playground: JavaParser-based AST,
        Three-Address-Code IR, dataflow analysis (taint-focused)
        and structured/style checks. Inspired by the architecture of
        Fathom but a completely independent Java-only project.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- dependency versions -->
        <javaparser.version>3.26.4</javaparser.version>
        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
        <jackson.version>2.17.2</jackson.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <commons-cli.version>1.9.0</commons-cli.version>
        <junit.version>5.10.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <z3.turnkey.version>4.14.0</z3.turnkey.version>

        <!--,
          Kotlin, for plumb-dsl-kotlin's script engine. 2.2.0 is the first
          release whose script engine understands JDK 25; 2.1.0 fails with
          "IllegalArgumentException: 25.0.1" and 1.9.22 does not know
          JDK 25 at all. Do not downgrade without re-running the DSL
          engine's self-test.
        -->
        <kotlin.version>2.2.0</kotlin.version>

        <!--,
          Kotlin Analysis API version for plumb-frontend (the Kotlin source frontend).

          LOCKED, and deliberately separate from the kotlin.version above:
          that one serves the DSL script engine (2.2.0 is the first release whose
          script engine understands JDK 25), while this one serves the ANALYSIS
          frontend, where the requirement is API maturity, not script-engine
          compatibility. Mixing them would bind two unrelated features together.

          The Analysis API is experimental: JetBrains marks it "in development
          and subject to incompatible changes" and only officially supports IDEA
          plugin development. So the version is pinned and upgraded deliberately,
          with the frontend's own tests re-run each time.
        -->
        <kotlin.analysis.api.version>2.5.0-Beta2</kotlin.analysis.api.version>

        <!--,
          The Kotlin STANDARD LIBRARY version, which is a THIRD thing: neither
          the DSL script engine's version nor the Analysis API's version.

          WHY IT NEEDS ITS OWN PIN. The two Kotlin features in this repository
          need different things, and the difference is not academic:

          - The DSL script engine (kotlin.version) needs a compiler whose
            script engine understands JDK 25. 2.2.0 is the first such release.
          - The Analysis API (kotlin.analysis.api.version) is built against a
            newer stdlib and USES kotlin/jvm/internal/KotlinGenericDeclaration,
            which does not exist before 2.3.x. Without it the frontend dies with
            NoClassDefFoundError at SESSION BUILD TIME, and because the
            frontend reports that as a "problem" rather than crashing, the scan
            silently produces ZERO findings for every Kotlin file. A Kotlin
            codebase would look clean.

          Maven's "nearest wins" would otherwise let the script engine's
          transitive stdlib 2.2.0 shadow the Analysis API's 2.3.21, because
          plumb-main depends on both. The result is exactly the failure above.

          So the stdlib version is pinned ONCE, here, in dependencyManagement,
          which makes it apply to EVERY module regardless of which path it
          arrives by. 2.3.21 is the version the Analysis API resolves to, and
          it is backward compatible with the 2.2.0 script engine: the
          standard library is additive within a major line.

          RAISE THIS ONLY TOGETHER WITH kotlin.analysis.api.version, and
          re-run the DSL engine's self-test AND the frontend's tests.
        -->
        <kotlin.stdlib.version>2.3.21</kotlin.stdlib.version>

        <!--,
          The kotlin-reflect version the Kotlin SCRIPT ENGINE was built against.

          A fourth version, and the least obvious of them. kotlin-compiler-embeddable
          2.2.0 declares kotlin-reflect 1.6.10, and the DSL script engine links
          against it. The Analysis API wants 2.3.x. Maven gives every module that
          depends on both the NEWEST version, so the script engine ends up with a
          reflect it was not built against and dies at construction with
          "Unable to load base class".

          Declaring this version does not make it win the resolution. It puts it on
          the CLASSPATH, so the script engine's isolated classloader can select the
          version its own compiler was built against, while the rest of the process
          keeps the 2.3.21 the Analysis API needs.

          Raise it ONLY together with kotlin.version, and re-run the DSL engine's
          self-test.
        -->
        <kotlin.script.reflect.version>1.6.10</kotlin.script.reflect.version>

        <!--,
          kotlinx-collections-immutable, the version the Kotlin Analysis API's
          IntelliJ surface classes need at COMPILE scope.

          A fifth Kotlin-adjacent version, and the least obvious of them,
          because it is not a Kotlin version at all: it is the Analysis API's
          own dependency on the IntelliJ platform's persistent collections.

          WHY IT IS PINNED. The Analysis API's compile-scope surface classes
          have a field of type kotlinx.collections.immutable.PersistentSet, and
          the aggregator declares that artifact at RUNTIME scope. javac reads
          a field's type out of the classfile regardless of which scope
          fetched the classfile, so the type has to be resolvable at compile
          scope or the build fails with "cannot find the class file for
          kotlinx.collections.immutable.PersistentSet".

          The pin exists so the SCOPE fix and the VERSION live in one place.
          Raise it together with kotlin.analysis.api.version.
        -->
        <kotlin.collections.immutable.version>0.5.1</kotlin.collections.immutable.version>

        <!--,
          Scala 3 compiler version for plumb-frontend (the Scala source frontend).

          LOCKED: the frontend uses dotc's PluginPhase, which is compiler-internal
          API. dotc only guarantees cross-version compatibility for
          CrossVersion.full, so a minor upgrade must re-run the frontend's tests.
          3.10.0 is the newest stable 3.10 release.
        -->
        <scala3.version>3.10.0</scala3.version>

        <!-- R140: SootUp for bytecode (.jar/.class) analysis. -->
        <sootup.version>3.0.0</sootup.version>

        <!-- Maven plugin versions -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.3.1</maven.surefire.plugin.version>
        <maven.jar.plugin.version>3.4.1</maven.jar.plugin.version>
        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <maven.install.plugin.version>3.1.2</maven.install.plugin.version>
    </properties>

    <!--,
      THE BUILD IS GROUPED INTO LAYERS. Each layer is an aggregator POM that
      groups the modules of one layer; the modules themselves keep their
      top-level directories.

      WHY AGGREGATORS AND NOT SUBDIRECTORIES. The repository's gate scripts
      resolve module paths from the repository root: 43 of them, as
      REPO / "plumb-<name>". scripts/check_test_coverage.py goes further: it
      DISCOVERS the modules by iterating the root directory, and it complains
      about any module with tests that it does not know about. Move a module
      into a subdirectory and that gate stops seeing it. It does not fail; it
      silently stops checking, which is worse than not having the gate.

      Moving a module is also a path change, not a design change: Maven orders
      the reactor by the dependency graph, so the layer boundaries are already
      enforced at build time. Declaring them here makes the layering
      explicit and readable without putting 43 scripts at risk.

        plumb-core    the foundation: parser, rules, reporter
        plumb-engine  the analysis engine: tac, frontend, dfa, style, dsl, ai
        plumb-app     the entry points: main, build
    -->
    <modules>
        <module>plumb-core</module>
        <module>plumb-engine</module>
        <module>plumb-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-parser</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-tac</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-frontend</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-rules</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-style</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-reporter</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-dfa</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-build</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-build-core</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-build-maven</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-build-capture</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-ai</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-dsl-kotlin</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.plumb</groupId>
                <artifactId>plumb-main</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>

            <!-- third-party -->
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-symbol-solver-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-cli</groupId>
                <artifactId>commons-cli</artifactId>
                <version>${commons-cli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.aqua</groupId>
                <artifactId>z3-turnkey</artifactId>
                <version>${z3.turnkey.version}</version>
            </dependency>

            <!--, R140: SootUp for bytecode analysis. 3.0.0 is the
                 latest release (2026-07-16). We need the bytecode
                 frontend to convert .jar/.class → Jimple, the core
                 for the Project / SootClass / Body APIs, the java
                 core for Java-specific type information, and
                 interceptors for the analysis pipeline. -->
            <dependency>
                <groupId>org.soot-oss</groupId>
                <artifactId>sootup.core</artifactId>
                <version>${sootup.version}</version>
            </dependency>
            <dependency>
                <groupId>org.soot-oss</groupId>
                <artifactId>sootup.java.core</artifactId>
                <version>${sootup.version}</version>
            </dependency>
            <dependency>
                <groupId>org.soot-oss</groupId>
                <artifactId>sootup.java.bytecode.frontend</artifactId>
                <version>${sootup.version}</version>
            </dependency>
            <dependency>
                <groupId>org.soot-oss</groupId>
                <artifactId>sootup.interceptors</artifactId>
                <version>${sootup.version}</version>
            </dependency>

            <!-- Kotlin Analysis API: plumb-frontend's Kotlin source frontend. -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-analysis-api-standalone-implementation</artifactId>
                <version>${kotlin.analysis.api.version}</version>
            </dependency>
            <!--,
              The stdlib pin. See the kotlin.stdlib.version property for why this
              is separate from both Kotlin versions and why it has to be in
              dependencyManagement rather than left to the nearest-wins rule.
            -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.stdlib.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-analysis-api-standalone-surface</artifactId>
                <version>${kotlin.analysis.api.version}</version>
            </dependency>
            <!--,
              kotlinx-collections-immutable, at compile scope.

              The Analysis API's compile-scope IntelliJ surface classes have a
              field of type kotlinx.collections.immutable.PersistentSet, and
              the artifact that declares it declares it at RUNTIME scope. javac
              reads a field's type out of the classfile regardless of the scope
              that fetched the classfile, so the type must be resolvable at
              compile scope or the build fails.

              The version is pinned here so the scope fix and the version live
              in ONE place. It is the version the Analysis API aggregator
              resolves today; raise it together with
              kotlin.analysis.api.version.
            -->
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-collections-immutable-jvm</artifactId>
                <version>${kotlin.collections.immutable.version}</version>
            </dependency>

            <!-- Scala 3 compiler: plumb-frontend's Scala source frontend. -->
            <dependency>
                <groupId>org.scala-lang</groupId>
                <artifactId>scala3-compiler_3</artifactId>
                <version>${scala3.version}</version>
            </dependency>

            <!--, R-833 P0: Maven model reader for the MavenAdapter.
                 The other adapters (Gradle / Bazel / Ant) live in
                 plumb-build and pull their own deps if needed. -->
            <dependency>
                <groupId>org.apache.maven</groupId>
                <artifactId>maven-model</artifactId>
                <version>3.9.9</version>
            </dependency>
            <dependency>
                <groupId>org.codehaus.plexus</groupId>
                <artifactId>plexus-utils</artifactId>
                <version>3.5.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>17</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
