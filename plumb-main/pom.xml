<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                              http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.plumb</groupId>
        <artifactId>plumb</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>plumb-main</artifactId>
    <name>plumb-main</name>
    <description>CLI entry + YAML config + pipeline orchestration.</description>
    <dependencies>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-tac</artifactId>
        </dependency>
        <!--,
            The non-Java source frontends (Kotlin, Scala 3).

            This is what makes .kt and .scala files SCANNABLE rather than merely
            implemented: ScanRunner dispatches each source file to the frontend
            that claims its extension, and every frontend lowers to the same TAC,
            so the DFA engine sees one uniform program.

            It is a compile dependency, not an optional one. The frontends are
            the only way Kotlin and Scala code enters the analysis, so making it
            optional would mean "the flag exists but does nothing".
        -->
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-frontend</artifactId>
        </dependency>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-dfa</artifactId>
        </dependency>
        <!--,
            The AST rule engine. Optional at runtime: without it the
            dsl-rules flag is simply unavailable, and the scan is
            unaffected. It is a compile dependency so the CLI can offer
            the flag.
        -->
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-dsl-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-build-core</artifactId>
        </dependency>
        <!--, The transitive-resolution Maven adapter. It registers itself
             through the ServiceLoader, so the CLI can auto-detect it. -->
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-build-maven</artifactId>
        </dependency>
        <!--, The compile-capture agent's capture format. The CLI reads the
             captures a build wrote and turns them into a compilation
             database, and then into the TAC the analysis runs on. The agent
             module itself has no internal dependency, so depending on it here
             does not couple it to anything. -->
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-build-capture</artifactId>
        </dependency>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-rules</artifactId>
        </dependency>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-style</artifactId>
        </dependency>
        <dependency>
            <groupId>org.plumb</groupId>
            <artifactId>plumb-reporter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <!--, R-? — AI dedup client. Uses the JDK
             java.net.http.HttpClient for the POST and
             Jackson for the request/response JSON. Jackson
             databind is pulled transitively by plumb-rules
             but we declare it explicitly here so the
             ai/ package compiles standalone. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.plumb.main.SastMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <!--,
                              THE KOTLIN SCRIPTING CLASS COLLISION.

                              The Analysis API's implementation jar bundles a whole
                              Kotlin scripting stack (302 classes under
                              org/jetbrains/kotlin/scripting) that the ANALYSIS
                              path never uses: none of the eight analysis-api
                              jars references any of those classes.

                              But the DSL rule engine (plumb-dsl-kotlin) runs on
                              the Kotlin 2.2.0 script engine, and 127 of those
                              classes collide by name. One of them,
                              CompilationContextKt.createIsolatedCompilationContext$default,
                              differs ONLY in one parameter type:

                                2.2.0   org.jetbrains.kotlin.com.intellij...Disposable
                                2.5.0   com.intellij...Disposable

                              Same name, same arity, different type, so the
                              caller's descriptor does not match the callee's and
                              the DSL engine dies with NoSuchMethodError. Because
                              the failure is a "rule failed to compile" WARNING
                              and not a crash, the DSL rules silently stop
                              matching while every other rule keeps working.

                              THE SHADED JAR IS NOT WHERE THIS IS SOLVED. It is
                              solved in the CLASSLOADER: the script engine runs
                              in its own loader that owns the Kotlin compiler
                              packages and serves their RESOURCES from its own
                              jars too. See ScriptEngineClassLoader in
                              plumb-dsl-kotlin.

                              What this shade configuration must therefore do is
                              keep the two stacks' RESOURCES apart, because the
                              compiler's IntelliJ platform finds its extension
                              points by reading META-INF/extensions/compiler.xml
                              out of whichever jar the resource resolves to. The
                              Analysis API's copy of that file has no <id>, and
                              reading it makes the script engine fail to start
                              with "Neither id nor name are specified".

                              So: the Analysis API's copy of the compiler's
                              extension-point descriptors is removed here, and
                              the script engine's own copy survives. The
                              analysis path does not use them.
                            -->
                            <filters>
                                <filter>
                                    <artifact>org.jetbrains.kotlin:kotlin-analysis-api-implementation</artifact>
                                    <excludes>
                                        <exclude>org/jetbrains/kotlin/scripting/**</exclude>
                                        <exclude>kotlin/script/**</exclude>
                                        <!--,
                                          The IntelliJ plugin descriptor the Kotlin
                                          compiler reads at start-up. The Analysis
                                          API's copy has no <id> and no <name>, so
                                          the plugin loader throws "Neither id nor
                                          name are specified" and the script engine
                                          cannot initialise its REPL. The script
                                          engine's own copy has an <id> and lives in
                                          kotlin-compiler-embeddable.
                                        -->
                                        <exclude>META-INF/extensions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.plumb.main.SastMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
